# Mayhem target: strictyaml YAML parser / round-trip (Atheris/libFuzzer harness).
# The cmd binary is the compiled ELF launcher that drives mayhem/fuzz_yaml.py; Atheris
# instruments the strictyaml library so the run records coverage (edges).
project: strictyaml
target: fuzz-load

cmds:
  - cmd: /mayhem/strictyaml_fuzzer
    libfuzzer: true

# Seed corpus lives under mayhem/seeds (bootstrap inputs; Mayhem accumulates corpus over time).
